---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Hello!</h1>
			<p>
				Welcome to the Chenghui's blog.
			</p>
			<p>
				This is my first blog website.
			</p>
			<p>
				You will see some of what I've shared.
			</p>
			<p>Here are a few things you will see:</p>
			<ul>
				<li>Short articles for practicing English</li>
				<li>Some useful little tricks</li>
				<li>Some paper shares</li>
				<li>A collection of all blogs</li>
				<li>About Me</li>
			</ul>
			<p>
				Have fun! If you get stuck, let me know.
			</p>
			<p>
				Want to know more? send to me.
			</p>
		</main>
		<Footer />
	</body>
</html>
